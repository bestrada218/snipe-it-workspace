#!/usr/bin/env bash
# Day-to-day commands for a Snipe-IT Workspace installation.
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
cd "$DIR"

docker_cmd() { if docker info >/dev/null 2>&1; then docker "$@"; else sudo docker "$@"; fi; }
compose() { docker_cmd compose -f compose.workspace.yml "$@"; }
port() { grep '^APP_PORT=' .env | cut -d= -f2 | tr -d "'\"" | grep . || echo 8000; }
CRON_MARK="# snipe-it-workspace auto-update"
SYNC_MARK="# snipe-it-workspace backups-folder"
DUMPS=/var/lib/snipeit/dumps

# Backups are also kept in a normal folder of the user's Documents, so they
# can be opened from the Files app without administrator access.
backups_folder() {
    if [ -n "${WORKSPACE_BACKUP_DIR:-}" ]; then
        echo "$WORKSPACE_BACKUP_DIR"
        return
    fi
    local documents
    documents="$(xdg-user-dir DOCUMENTS 2>/dev/null || true)"
    if [ -z "$documents" ] || [ "$documents" = "$HOME" ]; then
        documents="$HOME/Documents"
    fi
    echo "$documents/Snipe-IT Workspace backups"
}

# Copies new backups to the folder and removes the ones the server already
# cleaned up, so the folder mirrors what the server keeps.
sync_backups() {
    local folder server_list
    folder="$(backups_folder)"
    mkdir -p "$folder"
    server_list="$(compose exec -T app sh -c "ls -1 $DUMPS 2>/dev/null" | tr -d '\r' | grep '\.zip$' || true)"
    local copied=0
    while IFS= read -r file; do
        [ -n "$file" ] || continue
        if [ ! -f "$folder/$file" ]; then
            compose cp "app:$DUMPS/$file" "$folder/$file" >/dev/null
            copied=$((copied + 1))
        fi
    done <<< "$server_list"
    local removed=0
    for local_file in "$folder"/*.zip; do
        [ -e "$local_file" ] || continue
        if ! grep -qxF "$(basename "$local_file")" <<< "$server_list"; then
            rm -f "$local_file"
            removed=$((removed + 1))
        fi
    done
    echo "Backups folder: $folder ($copied new, $removed removed)"
}

# Nightly copy after the 01:30 backup; added once, kept on updates.
ensure_backup_sync_schedule() {
    if crontab -l 2>/dev/null | grep -qF "$SYNC_MARK"; then
        return
    fi
    mkdir -p "$HOME/.local/state"
    { crontab -l 2>/dev/null || true
      echo "15 2 * * * $DIR/scripts/snipe-it-workspace sync-backups >> $HOME/.local/state/snipe-it-workspace-backups.log 2>&1 $SYNC_MARK"; } | crontab -
}

case "${1:-help}" in
    update)
        shift
        exec "$DIR/scripts/workspace-update.sh" "$@"
        ;;
    status)
        echo "Version: $(git log -1 --format='%h  %cd  %s' --date=short)"
        compose ps --format 'table {{.Service}}\t{{.Status}}'
        if curl -fsS "http://localhost:$(port)/health" >/dev/null 2>&1; then
            echo "Application: answering on $(grep '^APP_URL=' .env | cut -d= -f2-)"
        else
            echo "Application: NOT answering. See: snipe-it-workspace logs"
        fi
        ;;
    backup)
        compose exec -T --user docker app php artisan snipeit:backup
        sync_backups
        ;;
    backups)
        compose exec -T app sh -c "ls -lh $DUMPS"
        echo "Also in: $(backups_folder)"
        ;;
    sync-backups)
        sync_backups
        ensure_backup_sync_schedule
        ;;
    logs)
        compose logs -f --tail=100 app
        ;;
    restart)
        # Recreate (not just restart) so changes made to .env take effect.
        compose up -d --force-recreate app
        ;;
    start)
        compose up -d
        ;;
    stop)
        compose stop
        ;;
    auto-update)
        current="$(crontab -l 2>/dev/null | grep -v "$CRON_MARK" || true)"
        case "${2:-status}" in
            on)
                mkdir -p "$HOME/.local/state"
                { [ -n "$current" ] && printf '%s\n' "$current"
                  echo "30 3 * * * $DIR/scripts/workspace-update.sh >> $HOME/.local/state/snipe-it-workspace-update.log 2>&1 $CRON_MARK"; } | crontab -
                echo "Automatic updates: ON (every night at 3:30). Log: ~/.local/state/snipe-it-workspace-update.log"
                ;;
            off)
                printf '%s\n' "$current" | crontab -
                echo "Automatic updates: OFF"
                ;;
            *)
                crontab -l 2>/dev/null | grep -q "$CRON_MARK" && echo "Automatic updates: ON (every night at 3:30)" || echo "Automatic updates: OFF"
                ;;
        esac
        ;;
    *)
        cat <<HELP
Snipe-IT Workspace ($(git log -1 --format=%h))

  snipe-it-workspace status              is it running, which version
  snipe-it-workspace update              install the latest version (backs up first)
  snipe-it-workspace backup              make a backup now
  snipe-it-workspace backups             list the backups on this server
  snipe-it-workspace sync-backups        copy them now to $(backups_folder)
  snipe-it-workspace logs                follow the application log
  snipe-it-workspace restart|start|stop  control the application
  snipe-it-workspace auto-update on|off  nightly automatic updates
HELP
        ;;
esac
